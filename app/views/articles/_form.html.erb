<div class="container">

  <%= render "shared/errors", obj: @article %>

  <div class="row justify-content-center">
    <div class="col-10">
      <%= form_with(model: @article, class: "shadow p-3 mb-3 bg-white rounded") do |form| %>
        <div class="form-group row">
          <%= form.label :title,'Titre', class: "col-2 col-form-label mb-3 text-black" %>
          <div class="col-10">
            <%= form.text_field :title, class: "form-control shadow rounded", placeholder: "votre titre" %>
          </div>
        </div>

        <div class="form-group row">
          <%= form.label :description, class: "col-2 col-form-label text-black" %>
          <div class="col-10">
            <%= form.text_area :description, rows: 10, class: "form-control mb-3 shadow rounded", placeholder: "Une description" %>
          </div>
        </div>

        <div class="form-group row">
          <%= form.label :category, "Catégories", class: "col-2 col-form-label text-black" %>
          <div class="col-10">
             <%= form.collection_select(:category_ids, Category.all, :id, :name, {prompt: "Faites votre sélection :"}, { multiple: true, size: 5, class: "custom-select shadow rounded container fluid mb-3" }) %>
          </div>
        </div>

        <div class="form-group row justify-content-center">
          <%= form.submit "Sauvegarder l'Article", class: "btn btn-dark btn-lg mb-3" %>
        </div>
      <% end %>
    </div>

    <%= link_to "[Retour à la liste des articles]", articles_path, class: "btn text-danger" %>
  </div>
</div>