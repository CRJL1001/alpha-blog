<div class="container">

  <%= render "errors" %>

  <div class="row justify-content-center">
    <div class="col-10">
      <%= form_with(model: @article, class: "shadow p-3 mb-3 bg-white rounded") do |form| %>
        <div class="form-group row">
          <%= form.label :title, class: "col-2 col-form-label mb-3 text-black" %>
          <div class="col-10">
            <%= form.text_field :title, class: "form-control shadow rounded" %>
          </div>
        </div>

        <div class="form-group row">
          <%= form.label :description, class: "col-2 col-form-label text-black" %>
          <div class="col-10">
            <%= form.text_area :description, rows: 10, class: "form-control mb-3 shadow rounded" %>
          </div>
        </div>

        <div class="form-group row justify-content-center">
          <%= form.submit class: "btn btn-dark btn-lg mb-3" %>
        </div>
      <% end %>
    </div>

    <%= link_to "[Retour à la liste des articles]", articles_path, class: "btn text-danger" %>
  </div>
</div>