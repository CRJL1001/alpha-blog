<h1 class="text-center mt-4 text-black mb-4">Profil de <%= @user.username %></h1>

<%= gravatar_for @user, size: 200 %>

<div class="text-center mt-4">
    <% if !logged_out? && (@user == current_user || current_user.admin? ) %>
     <%= link_to "Modifier mon profil", edit_user_path(@user), class: "btn btn-info"%>
    <% end %>
</div>

<h3 class="text-center mt-4">Articles :</h3>

 <div class="flickr_pagination mt-3">
    <%= will_paginate @articles, :container => false %>
</div>  

<%= render "shared/articles" %>

<div class="flickr_pagination mb-5">
    <%= will_paginate @articles, :container => false %>
</div>  