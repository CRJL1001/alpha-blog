<h1 class="text-center mt-4 text-black mb-4">Catégorie :  <%= @category.name %></h1>

<div class="text-center">
    <% if !logged_out? && current_user.admin? %>
     <%= link_to "Modifier la catégorie", edit_category_path(@category), class: "btn btn-info"%>
    <% end %>
</div>
    

<h3 class="text-center mt-4">Articles</h3>

<div class="flickr_pagination mt-3">
    <%= will_paginate @articles, :container => false %>
</div>  

<%= render "shared/articles" %>

<div class="flickr_pagination mb-5">
    <%= will_paginate @articles, :container => false %>
</div>  