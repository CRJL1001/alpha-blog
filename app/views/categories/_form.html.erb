<div class="container">
  <div class="row justify-content-center">
    <div class="col-10">
        <%= render "shared/errors", obj: @category %>
      <%= form_with(model: @category, class: "shadow p-3 mb-3 bg-white rounded") do |form| %>
        <div class="form-group row">
          <%= form.label :name, "Categorie", class: "col-2 col-form-label text-black" %>
          <div class="col-10">
            <%= form.text_field :name, class: "form-control mb-3 shadow rounded", placeholder: "nom de la categorie" %>
          </div>
        </div>

        <div class="form-group row justify-content-center">
          <%= form.submit message, class: "btn btn-dark btn-lg mb-3" %>
        </div>
      <% end %>
    </div>

    <%= link_to "[Retour à la liste des articles]", articles_path, class: "btn text-danger" %>
  </div>
</div>