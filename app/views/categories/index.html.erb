<h1 class="text-center mt-4" id="index-title">Liste des Catégories</h1>



<div class="container">
  <div class="flickr_pagination mt-3">
    <%= will_paginate @categories, :container => false %>
  </div>    
    <% @categories.each do |category| %>
    <div class="row justify-content-md-center">
      <div class="col-8">
        <div class="card text-center mt-4 shadow mb-5 bg-white rounded">
          <div class="card-header font-italic">
            par <%= link_to "#{category.name}", category_path(category)%>
          </div>
          <div class="card-body">
            <h5 class="card-title"><%= link_to category.name, category_path(category), class: "text-success" %></h5>
            <%= link_to "Voir plus", category_path(category), class: "btn btn-outline-success" %>
            <p class="card-text mt-2"><%= pluralize(category.articles.count, "article")%></p>
          </div>
          
          <div class="card-footer text-body-secondary">
            <small> Créé il y a <%= time_ago_in_words(category.created_at) %></small>
          </div>
        </div>
      </div>
    </div>
    <% end%>
  <div class="flickr_pagination mb-5">
    <%= will_paginate @categories, :container => false %>
  </div>  
</div>