<h1 class="text-center mt-4 text-black mb-4">Connexion</h1>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-10">
      <%= form_with(scope: :session, url: login_path, class: "shadow p-3 mb-3 bg-white rounded") do |form| %>
        <div class="form-group row">
          <%= form.label :email, class: "col-2 col-form-label text-black" %>
          <div class="col-10">
            <%= form.text_field :email, class: "form-control mb-3 shadow rounded", placeholder: "email" %>
          </div>
        </div>

        <div class="form-group row">
          <%= form.label :password, class: "col-2 col-form-label mb-3 text-black" %>
          <div class="col-10">
            <%= form.password_field :password, class: "form-control shadow rounded", placeholder: "mot de passe"%>
          </div>
        </div>

        <div class="form-group row justify-content-center">
          <%= form.submit "Se connecter", class: "btn btn-dark btn-lg mb-3" %>
        </div>
      <% end %>
    </div>

    <%= link_to "[Retour à la liste des articles]", articles_path, class: "btn text-danger" %>
  </div>
</div>